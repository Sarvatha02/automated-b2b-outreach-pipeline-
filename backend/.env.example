# ============================================================
# Automated Outreach Pipeline - Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys.
# The app works in mock/demo mode without API keys.

# --- Ocean.io API (Similar Company Discovery) ---
# Sign up: https://ocean.io
OCEAN_API_KEY=your_ocean_api_key_here
OCEAN_API_URL=https://api.ocean.io/v1

# --- Prospeo API (Decision Maker Discovery) ---
# Sign up: https://prospeo.io
PROSPEO_API_KEY=your_prospeo_api_key_here
PROSPEO_API_URL=https://api.prospeo.io/v1

# --- Eazyreach API (Email Resolution) ---
# Sign up: https://eazyreach.io
EAZYREACH_API_KEY=your_eazyreach_api_key_here
EAZYREACH_API_URL=https://api.eazyreach.io/v1

# --- Brevo API (Email Sending) ---
# Sign up: https://brevo.com (free tier available)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_API_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=outreach@yourdomain.com
BREVO_SENDER_NAME=Your Name

# --- Pipeline Settings ---
MAX_SIMILAR_COMPANIES=20
MAX_CONTACTS_PER_COMPANY=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0

# --- App Settings ---
LOG_LEVEL=INFO
DEBUG=false
